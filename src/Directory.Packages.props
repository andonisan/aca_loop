<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- App packages -->
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />

    <!-- Hosting (Agent worker, plain Sdk="Microsoft.NET.Sdk" console app). Floor raised to what
         Aspire.Hosting.Azure.Storage 13.4.6 requires transitively (CPM transitive pinning). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />

    <!-- Vendor clients. Floors raised to what Aspire.Hosting.Azure.Storage 13.4.6 requires
         transitively (CPM transitive pinning) — the AppHost project references this package too. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageVersion Include="Azure.Storage.Queues" Version="12.26.0" />
    <!-- Portal read-model sources: ACA job executions and Log Analytics KQL, both read through the
         portal's own managed identity. -->
    <PackageVersion Include="Azure.ResourceManager.AppContainers" Version="1.3.0" />
    <PackageVersion Include="Azure.Monitor.Query" Version="1.6.0" />
    <!-- Floor raised from 8.2.1 to what Microsoft.Identity.Web 4.0.0 requires transitively (CPM
         transitive pinning) — the Portal host references that package. Same 8.x line the GitHub
         module's App-token minting already used. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />

    <!-- Portal (Blazor Server host): Entra ID sign-in and the sign-in/out UI endpoints. -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.0.0" />
    <!-- Pinned forward off Microsoft.Identity.Web's transitive 9.0.0, which carries several
         high-severity advisories (NU1903; audit is an error here). 10.0.10 is the first patched
         release in the 10.x line (CVE-2026-50648 et al. affect <= 10.0.9). Transitive pinning is
         what makes this stick without any project referencing the package directly. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />

    <!-- API / observability -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.7" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />

    <!-- Aspire dev orchestration -->
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.4.6" />

    <!-- Data. Pinned to the same versions ds-connect uses, so the two repos' persistence stacks do not
         drift (postgres-config-store design D9). EntityFrameworkCore.Design is referenced only by the
         startup host that authors migrations, never by a module. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />

    <!-- Test packages -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- FakeTimeProvider, so the read-model's TTL behavior is tested by advancing a clock rather than
         by sleeping. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!-- Browser tests. Same pin as ds-connect. Browsers come from a CDN rather than a container
         registry, which is why this suite is viable on machines where Docker Hub is not. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />

    <!-- Roslyn analyzer authoring. Microsoft.CodeAnalysis.CSharp pinned to 5.0.0 to match the
         Roslyn compiler bundled with the .NET 10 SDK (a newer package version fails to load: CS9057). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Testing.Verifiers.XUnit" Version="1.1.2" />
    <PackageVersion
      Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit"
      Version="1.1.2"
    />
  </ItemGroup>
</Project>
