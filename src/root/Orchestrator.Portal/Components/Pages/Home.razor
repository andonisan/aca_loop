@page "/"
@using Orchestrator.Portal.Registry
@inject StackRegistry Registry

@* This page is the reference consumer for the design system: the 3.x read-model pages copy these
   patterns, so it demonstrates them rather than merely rendering. Notably — title and count go to the
   topbar through a section while the h1 stays here for focus management, tabular data uses .dtable
   with two-line .cell-primary/.cell-secondary cells, and every Azure coordinate is .mono so
   identifiers scan as identifiers. *@

<SectionContent SectionName="@PortalSections.PageHeader">
    <div class="breadcrumbs">
        <span class="crumb-current">Portal</span>
    </div>
    <div class="page-title-row">
        <h1>Stacks</h1>
        <span class="count-pill">@Registry.Stacks.Count</span>
    </div>
</SectionContent>

<div class="card">
    <div class="card-head">
        <h2>Registered client stacks</h2>
        <span class="muted mono" style="font-size:var(--fs-12)">stacks.yaml</span>
    </div>
    <div class="card-body flush">
        @if (Registry.Stacks.Count == 0)
        {
            @* Unreachable in practice — the loader fails startup on an empty registry — but a table with
               no rows and no explanation is the worse failure if that ever stops being true. *@
            <div class="empty">
                <span>No client stacks are registered.</span>
            </div>
        }
        else
        {
            <table class="dtable">
                <thead>
                    <tr>
                        <th>Stack</th>
                        <th>Resource group</th>
                        <th>Job</th>
                        <th>Queue</th>
                        <th>Mapping</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stack in Registry.Stacks)
                    {
                        <tr>
                            <td>
                                <div class="cell-primary">
                                    <a href="@($"/stacks/{stack.Id}")">@stack.DisplayName</a>
                                </div>
                                <div class="cell-secondary mono">@stack.Id</div>
                            </td>
                            <td class="mono">@stack.Azure.ResourceGroup</td>
                            <td class="mono">@stack.Azure.JobName</td>
                            <td class="mono">@stack.Azure.QueueName</td>
                            <td class="mono">@Path.GetFileName(stack.MappingFilePath)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="banner info">
    <span class="banner-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4M12 8h.01" />
        </svg>
    </span>
    <span>
        Gated work items land in <span class="mono">orchestrator-portal</span> task 3.3, which needs a
        read-only listing capability the vendor adapters do not have yet. Queue depth, pods, and run
        history are on each stack's page.
    </span>
</div>
