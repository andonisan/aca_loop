<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Orchestrator.Portal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.Query" />
    <PackageReference Include="Azure.ResourceManager.AppContainers" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Microsoft.Identity.Web.UI" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orchestrator.Portal.UnitTests" />
    <InternalsVisibleTo Include="Orchestrator.Portal.FunctionalTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Orchestrator.BuildingBlocks\Orchestrator.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\shared\Orchestrator.Constants\Orchestrator.Constants.csproj" />
    <ProjectReference Include="..\..\shared\Orchestrator.ServiceDefaults\Orchestrator.ServiceDefaults.csproj" />
    <!-- Contracts only. The Portal reads vendors through IBacklogReader and must never reference a
         vendor module's implementation, which is also what MOD002 enforces. -->
    <ProjectReference Include="..\..\modules\Backlog\Orchestrator.Modules.Backlog.Contracts\Orchestrator.Modules.Backlog.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="stacks.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="mappings\**\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
